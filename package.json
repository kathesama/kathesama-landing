{
  "name": "kathesama-landing",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.1",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "architecture:prepare": "tsx scripts/prepare-public-architecture.ts",
    "audit:architecture": "tsx scripts/audit-public-architecture.ts",
    "predev": "pnpm architecture:prepare",
    "dev": "vite",
    "build:client": "tsc -b && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr-blog",
    "prerender": "tsx scripts/prerender-public-routes.ts",
    "verify:blog-build": "tsx scripts/verify-blog-build.ts",
    "build": "pnpm architecture:prepare && pnpm validate:blog && pnpm build:client && pnpm build:ssr && pnpm prerender && pnpm verify:blog-build",
    "import:medium": "tsx scripts/import-medium-blog.ts --dry-run",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "validate:architecture": "tsx scripts/prepare-public-architecture.ts",
    "validate:blog": "tsx scripts/validate-blog-content.ts",
    "validate:public": "pnpm validate:blog && pnpm audit:architecture && pnpm architecture:prepare",
    "check": "pnpm validate:public && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "29.1.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "unified": "^11.0.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vitest-axe": "^0.1.0",
    "zod": "^4.6.5"
  }
}
